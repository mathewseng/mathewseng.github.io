+/* A continuation's checker decisions use pciMove, which may differ from the
+ * counterfactual cube being valued. Retain that context in money cache keys.
+ * Match keys have no spare score fields: do not cache incompatible policies. */
+static int
+CheckerPolicyCacheKey(const evalcontext *ec,int plies,const cubeinfo *branch,const cubeinfo *policy)
+{
+    int key=EvalKey(ec,plies,branch,TRUE);
+    if(plies>0 && !branch->nMatchTo) {
+        key ^= (policy->fCubeOwner<0?2:policy->fCubeOwner==policy->fMove)<<7;
+        key ^= policy->fJacoby<<9;
+        key ^= policy->fBeavers<<10;
+        key ^= LogCube(policy->nCube)<<11;
+        key ^= policy->fMove<<16;
+    }
+    return key;
+}
+static int
+CanCacheCheckerPolicy(const cubeinfo *branch,const cubeinfo *policy,int plies)
+{
+    if(!plies || !branch->nMatchTo)return 1;
+    return branch->nCube==policy->nCube && branch->fCubeOwner==policy->fCubeOwner &&
+        branch->fMove==policy->fMove && branch->nMatchTo==policy->nMatchTo &&
+        branch->anScore[0]==policy->anScore[0] && branch->anScore[1]==policy->anScore[1] &&
+        branch->fCrawford==policy->fCrawford && branch->fJacoby==policy->fJacoby &&
+        branch->fBeavers==policy->fBeavers && branch->bgv==policy->bgv;
 }
 
